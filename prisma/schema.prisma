// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  DISPATCHER
  COURIER
}

enum PickupStatus {
  // Created but unpaid — a Square payment link was generated and the
  // customer hasn't completed checkout yet. Not a real request until paid:
  // excluded from dispatch's default views, stats, and the daily report.
  DRAFT
  PENDING
  ASSIGNED
  SCHEDULED
  EN_CAMINO
  PICKED_UP
  CANCELLED
}

enum CaseType {
  LOST
  DAMAGED
  DELAYED
  WRONG_ITEM
  NOT_HOME
  OTHER
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum WebhookEventType {
  CREATED
  STATUS_CHANGED
}

enum WebhookDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id                 String          @id @default(cuid())
  email              String          @unique
  password           String?
  name               String
  phone              String?
  role               Role            @default(CUSTOMER)
  pickupRequests     PickupRequest[] @relation("CustomerRequests")
  courierAssignments PickupRequest[] @relation("CourierAssignments")
  comments           Comment[]       @relation("AuthoredComments")
  savedRecipients    SavedRecipient[]
  savedPickupAddresses SavedPickupAddress[]
  supportMessages    SupportMessage[] @relation("SupportThreadOwner")
  cases              Case[]          @relation("CustomerCases")
  termsAcceptedAt    DateTime?
  createdAt          DateTime        @default(now())
}

// A customer's saved recipient — lets recurring shippers (same person
// receiving every time) skip re-typing recipient info on each request.
model SavedRecipient {
  id                      String   @id @default(cuid())
  userId                  String
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label                   String
  recipientName           String
  recipientPhone          String
  recipientPhoneSecondary String?
  recipientEmail          String?
  recipientAddress        String
  recipientCity           String
  recipientState          String?
  recipientPostalCode     String?
  recipientCountry        String
  destinationCountry      String
  createdAt               DateTime @default(now())

  @@index([userId])
}

// A customer's saved pickup (sender) address — lets a recurring shipper
// who always ships from the same place skip re-typing it every time.
model SavedPickupAddress {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String
  address    String
  city       String
  state      String?
  postalCode String?
  country    String
  createdAt  DateTime @default(now())

  @@index([userId])
}

model PickupRequest {
  id                  String          @id @default(cuid())
  trackingCode        String          @unique
  userId              String?
  user                User?           @relation("CustomerRequests", fields: [userId], references: [id])
  contactName         String
  contactPhone        String
  contactEmail        String?
  pickupAddress       String
  pickupCity          String
  pickupState         String?
  pickupPostalCode    String?
  pickupCountry       String
  recipientName       String
  recipientEmail      String?
  recipientPhone      String
  recipientPhoneSecondary String?
  recipientAddress    String
  recipientCity       String
  recipientState      String?
  recipientPostalCode String?
  recipientCountry    String
  destinationCountry  String
  // "MARITIME" or "AIR" — which modality was chosen/priced for this request.
  shippingMode        String          @default("MARITIME")
  packageType         String
  estimatedWeight     Float?
  dimensions          String?
  packageContents     String?
  packageItems        String?
  // Declared/insured value (USD) — required on every new request as of
  // the shipping-insurance policy change; kept nullable so pre-existing
  // rows created before that change stay valid.
  declaredValue       Float?
  insuranceRequested  Boolean         @default(false)
  insuranceValue      Float?
  preferredDate       DateTime
  preferredTimeWindow String
  specialInstructions String?
  notes               String?
  status              PickupStatus    @default(PENDING)
  assignedCourierId   String?
  assignedCourier     User?           @relation("CourierAssignments", fields: [assignedCourierId], references: [id])
  statusHistory       StatusHistory[]
  comments            Comment[]
  cases               Case[]
  webhookDeliveries   WebhookDelivery[]
  discountCode        String?
  discountPercent     Float?
  lang                String?
  callStatus          String?
  callAttempts        Int             @default(0)
  lastCallId          String?
  lastCallAt          DateTime?
  proofPhotoUrl       String?
  // 4-digit pickup verification code. Only the customer sees it (guía,
  // email, success screen); the courier must enter it to confirm pickup.
  securityCode        String?
  // Server-computed price (never trust a client-supplied amount for a real
  // charge) — in cents to avoid float rounding on money.
  priceCents          Int?
  paymentStatus       String?         @default("UNPAID")
  squarePaymentLinkId String?
  squarePaymentLinkUrl String?
  // Square's Order id, not the payment link id — this is what the
  // `payment.updated` webhook payload actually references, so it's what we
  // key off of to find the pickup a completed payment belongs to.
  squareOrderId       String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  // Dashboard filters, courier views, calendar and webhook lookups all scan
  // these columns — indexed so they stay fast as the table grows.
  @@index([userId])
  @@index([assignedCourierId])
  @@index([status])
  @@index([squareOrderId])
  @@index([preferredDate])
  @@index([contactPhone])
  @@index([createdAt])
}

model StatusHistory {
  id              String         @id @default(cuid())
  pickupRequestId String
  pickupRequest   PickupRequest  @relation(fields: [pickupRequestId], references: [id])
  fromStatus      PickupStatus?
  toStatus        PickupStatus
  changedById     String?
  notes           String?
  // Most `notes` are internal staff shorthand and must never reach the
  // public tracking page. Case-opened entries are the one kind of note
  // written specifically for the customer to read — this flag is the only
  // thing that lets /api/track expose a note without risking a leak.
  notesArePublic  Boolean        @default(false)
  createdAt       DateTime       @default(now())

  @@index([pickupRequestId])
}

model Comment {
  id              String        @id @default(cuid())
  pickupRequestId String
  pickupRequest   PickupRequest @relation(fields: [pickupRequestId], references: [id], onDelete: Cascade)
  authorId        String
  author          User          @relation("AuthoredComments", fields: [authorId], references: [id], onDelete: Cascade)
  authorName      String
  authorRole      String
  body            String
  createdAt       DateTime      @default(now())

  @@index([pickupRequestId])
}

// One continuous support conversation per customer — not tied to a single
// pickup request. Separate from Comment (which is staff-internal notes and
// must never reach the customer); every message here is visible to both
// sides by design.
model SupportMessage {
  id             String   @id @default(cuid())
  customerId     String
  customer       User     @relation("SupportThreadOwner", fields: [customerId], references: [id], onDelete: Cascade)
  senderId       String
  senderName     String
  senderRole     String
  isFromCustomer Boolean
  body           String
  createdAt      DateTime @default(now())
  // Read receipts are per side, not per staff member — any staff member
  // reading the thread marks it read for "staff" as a whole.
  readByCustomer Boolean  @default(false)
  readByStaff    Boolean  @default(false)

  @@index([customerId, createdAt])
}

// A support case opened by staff (ADMIN or DISPATCHER) for a specific
// shipment problem (lost, damaged, delayed, etc). customerId is optional
// because a pickup request can be created without an account (guest
// checkout) — the case still needs to be openable; it just won't show up
// under "Mi Cuenta" unless the pickup has a linked customer.
model Case {
  id              String     @id @default(cuid())
  pickupRequestId String
  pickupRequest   PickupRequest @relation(fields: [pickupRequestId], references: [id], onDelete: Cascade)
  customerId      String?
  customer        User?      @relation("CustomerCases", fields: [customerId], references: [id], onDelete: Cascade)
  createdById     String
  createdByName   String
  type            CaseType
  status          CaseStatus @default(OPEN)
  description     String
  resolutionNotes String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  resolvedAt      DateTime?
  notes           CaseNote[]

  @@index([pickupRequestId])
  @@index([customerId])
  @@index([status])
}

// A running log of updates on a case — "called the customer", "FedEx
// confirmed it's in transit", etc — separate from the final resolutionNotes
// so staff can track progress while the case is still open.
model CaseNote {
  id         String   @id @default(cuid())
  caseId     String
  case       Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  authorId   String
  authorName String
  body       String
  createdAt  DateTime @default(now())

  @@index([caseId, createdAt])
}

// One row per outbound webhook notification attempt-chain (pickup created,
// or status changed). Persisted so retries survive a process restart and
// can be swept by the /api/cron/retry-webhooks job — the equivalent of
// StatusHistory but for external notifications instead of internal audit.
model WebhookDelivery {
  id              String                @id @default(cuid())
  pickupRequestId String
  pickupRequest   PickupRequest         @relation(fields: [pickupRequestId], references: [id], onDelete: Cascade)
  eventType       WebhookEventType
  payload         Json
  status          WebhookDeliveryStatus @default(PENDING)
  attempts        Int                   @default(0)
  lastAttemptAt   DateTime?
  nextRetryAt     DateTime?
  responseCode    Int?
  createdAt       DateTime              @default(now())

  @@index([pickupRequestId])
  @@index([status, nextRetryAt])
}

model Pricing {
  id              String   @id @default(cuid())
  country         String
  // "MARITIME" (by box size) or "AIR" (per-lb rate, or fixed price per
  // AIR_ITEM_TYPES item when packageType is one of those categories).
  shippingMode    String   @default("MARITIME")
  packageType     String
  basePrice       Float
  weightThreshold Float    @default(20)
  weightRate      Float    @default(1.0)
  // Only used when shippingMode = AIR and packageType = AIR_PER_LB.
  pricePerLb      Float?
  minWeight       Float?
  maxWeight       Float?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([country, shippingMode, packageType])
}

model DiscountCode {
  id        String   @id @default(cuid())
  code      String   @unique
  percent   Float
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// Auth for external systems (CRM, etc) hitting protected API routes with an
// x-api-key header instead of a NextAuth session. `key` stores the SHA-256
// hash of the raw key — the raw value is only ever shown once, at creation.
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  key        String    @unique
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}
