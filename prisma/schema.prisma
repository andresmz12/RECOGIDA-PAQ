// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  DISPATCHER
  COURIER
}

enum PickupStatus {
  PENDING
  ASSIGNED
  SCHEDULED
  EN_CAMINO
  PICKED_UP
  CANCELLED
}

model User {
  id                 String          @id @default(cuid())
  email              String          @unique
  password           String?
  name               String
  phone              String?
  role               Role            @default(CUSTOMER)
  pickupRequests     PickupRequest[] @relation("CustomerRequests")
  courierAssignments PickupRequest[] @relation("CourierAssignments")
  comments           Comment[]       @relation("AuthoredComments")
  createdAt          DateTime        @default(now())
}

model PickupRequest {
  id                  String          @id @default(cuid())
  trackingCode        String          @unique
  userId              String?
  user                User?           @relation("CustomerRequests", fields: [userId], references: [id])
  contactName         String
  contactPhone        String
  contactEmail        String?
  pickupAddress       String
  pickupCity          String
  pickupState         String?
  pickupPostalCode    String?
  pickupCountry       String
  recipientName       String
  recipientEmail      String?
  recipientPhone      String
  recipientPhoneSecondary String?
  recipientAddress    String
  recipientCity       String
  recipientState      String?
  recipientPostalCode String?
  recipientCountry    String
  destinationCountry  String
  packageType         String
  estimatedWeight     Float?
  dimensions          String?
  packageContents     String?
  preferredDate       DateTime
  preferredTimeWindow String
  specialInstructions String?
  notes               String?
  status              PickupStatus    @default(PENDING)
  assignedCourierId   String?
  assignedCourier     User?           @relation("CourierAssignments", fields: [assignedCourierId], references: [id])
  statusHistory       StatusHistory[]
  comments            Comment[]
  callStatus          String?
  callAttempts        Int             @default(0)
  lastCallId          String?
  lastCallAt          DateTime?
  proofPhotoUrl       String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
}

model StatusHistory {
  id              String         @id @default(cuid())
  pickupRequestId String
  pickupRequest   PickupRequest  @relation(fields: [pickupRequestId], references: [id])
  fromStatus      PickupStatus?
  toStatus        PickupStatus
  changedById     String?
  notes           String?
  createdAt       DateTime       @default(now())
}

model Comment {
  id              String        @id @default(cuid())
  pickupRequestId String
  pickupRequest   PickupRequest @relation(fields: [pickupRequestId], references: [id], onDelete: Cascade)
  authorId        String
  author          User          @relation("AuthoredComments", fields: [authorId], references: [id], onDelete: Cascade)
  authorName      String
  authorRole      String
  body            String
  createdAt       DateTime      @default(now())
}

model Pricing {
  id              String   @id @default(cuid())
  country         String
  packageType     String
  basePrice       Float
  weightThreshold Float    @default(20)
  weightRate      Float    @default(1.0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([country, packageType])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
