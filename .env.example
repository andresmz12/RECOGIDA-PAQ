# Database
DATABASE_URL=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# ZyraVoice
ZYRA_URL=https://zyravoice.railway.app
ZYRA_USERNAME=
ZYRA_PASSWORD=
ZYRA_AGENT_ID_CONFIRMATION=
ZYRA_AGENT_ID_COURIER=
ZYRA_WEBHOOK_SECRET=

# Cloudinary (optional) — when set, proof photos are stored here instead of
# inline base64 in the database. Without these, photos fall back to base64.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=oglobo/proofs

# Upstash Redis (optional) — when set, rate limits are enforced globally across
# all server instances. Without these, limits fall back to per-instance memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
